{
    "project": {
        "name": "Sudoku Elite",
        "owner": "bbaakkuu-svg",
        "repo_name": "Proyecto_Sudoku"
    },
    "github_settings": {
        "project_number": 6
    },
    "git_flow": {
        "main_branch": "main",
        "develop_branch": "develop",
        "feature_prefix": "feature/",
        "release_prefix": "release/",
        "hotfix_prefix": "hotfix/"
    },
    "tech_stack": {
        "language": "java",
        "format_command": "mvn spotless:apply -q",
        "test_command": "mvn test -q",
        "coverage_command": "mvn clean test jacoco:report",
        "version_file": "pom.xml",
        "version_set_command": "mvn versions:set -DnewVersion={VERSION} -DgenerateBackupPoms=false -q"
    },
    "quality_gate": {
        "min_coverage": 80
    },
    "commit_lint": {
        "patterns": ["feat", "fix", "docs", "style", "refactor", "test", "chore"],
        "forbidden_words": ["crear", "nuevo", "arreglo", "corregido", "subida", "documentacion", "prueba", "error"],
        "min_length": 10
    },
    "security_scanner": {
        "blocked_patterns": ["password=", "secret=", "jdbc:mysql://.*:[0-9]+/", "127.0.0.1", "root", "admin123"]
    },
    "paths": {
        "src": "src/main/java",
        "tests": "src/test/java",
        "docs": "docs"
    },
    "webhooks": {
        "discord_release_url": "",
        "slack_release_url": ""
    }
}
