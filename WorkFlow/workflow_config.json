{
    "project": {
        "name": "Sudoku Elite",
        "owner": "bbaakkuu-svg",
        "repo_name": "Proyecto_Sudoku"
    },
    "github_settings": {
        "project_number": 6
    },
    "git_flow": {
        "main_branch": "main",
        "develop_branch": "develop",
        "feature_prefix": "feature/",
        "release_prefix": "release/",
        "hotfix_prefix": "hotfix/"
    },
    "quality_gate": {
        "min_coverage": 80,
        "test_command": "mvn clean test jacoco:report"
    },
    "commit_lint": {
        "patterns": ["feat", "fix", "docs", "style", "refactor", "test", "chore"],
        "forbidden_words": ["crear", "nuevo", "arreglo", "corregido", "subida", "documentacion", "prueba", "error"],
        "min_length": 10
    },
    "paths": {
        "src": "src/main/java",
        "tests": "src/test/java",
        "docs": "docs"
    }
}
